---
import Layout from "../../layouts/Layout.astro";
import { CategoryItems } from "../../components/menu/CategoryItems";
import { CATEGORIES } from "../../constants/categories";
import { EXTRAS } from "../../constants/extras";
import { getItemsByCategoryId } from "../../constants/items";

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category_id: category.category_id },
    props: {
      category,
      items: getItemsByCategoryId(category.category_id),
      extras: EXTRAS.find((extra) => extra.category_id === category.category_id)?.extras || [],
    },
  }));
}

const { category, items, extras } = Astro.props;
---

<Layout title={`${category.name} — Iratxe`}>
  <CategoryItems category={category} items={items} extras={extras} client:only="react" />
</Layout>
